---
import { projects } from '../data/content.js';

const spiralRings = Array.from({ length: 22 });
---

<section id="work" class="section">
  <div class="container">
    <!-- Heading on dark background -->
    <div class="section-head" data-reveal style="--i:1">
      <span class="kicker">
        <span>portfolio</span>
        <span class="mono">// 03</span>
      </span>
      <h2 class="display">Selected <em>Work.</em></h2>
      <p class="sub blurb">Full-stack & AI projects engineered for precision and real-world impact.</p>
    </div>

    <!-- Spiral Notebook Container -->
    <div class="spiral-notebook paper graph" data-reveal style="--i:2">
      <!-- Row of metal spiral rings across the top -->
      <div class="spiral-ring-strip" aria-hidden="true">
        {spiralRings.map(() => (
          <div class="spiral-ring">
            <div class="ring-hole"></div>
            <div class="ring-metal"></div>
          </div>
        ))}
      </div>

      <div class="notebook-inner">
        {projects.map((proj, idx) => {
          const isEven = idx % 2 === 0;
          const tilt = isEven ? -2.5 : 2.5;
          return (
            <article class="project-row" data-reveal style={`--i: ${idx + 2};`}>
              <!-- Left Side: Project details -->
              <div class="project-info">
                <div class="meta-tags">
                  <span class="role-tag hand">{proj.role}</span>
                  <span class="year-tag mono">{proj.year}</span>
                </div>

                <h3 class="project-title display">
                  <a href={proj.href} target="_blank" rel="noopener noreferrer">
                    {proj.title}
                    <svg class="external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </h3>

                <p class="stack-line mono">{proj.stack}</p>
                <p class="summary blurb">{proj.summary}</p>

                <div class="case-study-link">
                  <a href={proj.href} target="_blank" rel="noopener noreferrer" class="link-hand">
                    explore repository & details →
                  </a>
                </div>
              </div>

              <!-- Right Side: Tilted Project Screenshot -->
              <div class="project-image-wrap" style={`--tilt: ${tilt}deg;`}>
                <a href={proj.href} target="_blank" rel="noopener noreferrer" class="image-frame">
                  <img
                    src={proj.image}
                    alt={proj.alt}
                    loading="lazy"
                    width="600"
                    height="375"
                  />
                  <div class="image-overlay"></div>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .spiral-notebook {
    position: relative;
    padding-top: 48px;
    padding-bottom: clamp(48px, 6vw, 80px);
    border: 1px solid rgba(20, 24, 31, 0.1);
    box-shadow: var(--shadow-paper);
    margin-top: 24px;
  }

  /* Spiral binding metal rings across top */
  .spiral-ring-strip {
    position: absolute;
    top: -18px;
    left: 40px;
    right: 40px;
    display: flex;
    justify-content: space-between;
    z-index: 15;
    pointer-events: none;
  }

  .spiral-ring {
    position: relative;
    width: 14px;
    height: 36px;
  }

  .ring-hole {
    position: absolute;
    top: 14px;
    left: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #14181F;
    box-shadow: inset 1px 1px 2px rgba(0,0,0,0.8);
  }

  .ring-metal {
    position: absolute;
    top: 0;
    left: 3px;
    width: 8px;
    height: 32px;
    border-radius: 4px;
    background: linear-gradient(90deg, #666 0%, #E0E0E0 50%, #444 100%);
    box-shadow: 2px 4px 6px rgba(0,0,0,0.35);
  }

  .notebook-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(60px, 8vw, 110px);
    padding-inline: clamp(24px, 5vw, 64px);
  }

  .project-row {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .meta-tags {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .role-tag {
    background: var(--lime);
    color: var(--ink);
    padding: 3px 12px 5px;
    border-radius: 6px;
    border: 1.5px solid var(--ink);
    font-size: 20px;
    box-shadow: 2px 2px 0 var(--ink);
    transform: rotate(-2deg);
  }

  .year-tag {
    color: var(--ink-muted);
    font-size: 13px;
  }

  .project-title {
    font-size: clamp(32px, 4vw, 54px);
    line-height: 1.1;
    color: var(--ink);
  }

  .project-title a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: inherit;
    position: relative;
    padding-bottom: 4px;
  }

  /* Wavy lime underline on title hover */
  .project-title a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 8px;
    background: var(--wave-lime) repeat-x 0 0 / 20px 8px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity var(--dur-fast), transform var(--dur-fast);
  }

  .project-row:hover .project-title a::after {
    opacity: 1;
    transform: translateY(0);
  }

  .external-icon {
    width: 24px;
    height: 24px;
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity var(--dur-fast), transform var(--dur-fast);
  }

  .project-title a:hover .external-icon {
    opacity: 1;
    transform: translate(0, 0);
  }

  .stack-line {
    color: var(--lime-dark);
    font-size: 13px;
    font-weight: 600;
  }

  .summary {
    color: var(--ink-soft);
    font-size: 19px;
  }

  .case-study-link {
    margin-top: 8px;
  }

  /* Tilted photo frame */
  .project-image-wrap {
    transform: rotate(var(--tilt, 0deg));
    transition: transform var(--dur) var(--ease-spring);
  }

  .image-frame {
    display: block;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background: var(--ink);
    border: 3px solid #FFF;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .image-frame img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    transition: transform 500ms var(--ease-out);
  }

  .project-row:hover .project-image-wrap {
    transform: rotate(0deg) translateY(-10px) scale(1.03);
  }

  .project-row:hover .image-frame {
    box-shadow: 0 28px 56px rgba(0, 0, 0, 0.35);
  }

  .project-row:hover .image-frame img {
    transform: scale(1.04);
  }

  @media (max-width: 900px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .project-image-wrap {
      transform: rotate(0deg) !important;
    }
  }

  @media (max-width: 640px) {
    .spiral-ring-strip {
      left: 10px; right: 10px;
    }
  }
</style>

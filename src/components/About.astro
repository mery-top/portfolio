---
import { about } from '../data/content.js';
import Doodle from './Doodle.astro';
---

<section id="about" class="section">
  <div class="container">
    <div class="section-head" data-reveal style="--i:1">
      <span class="kicker">
        <span>about me</span>
        <span class="mono">// 01</span>
      </span>
      <h2 class="display">Crafting systems with <em>curiosity.</em></h2>
    </div>

    <div class="about-grid">
      <!-- Left Column: Bio & Skills -->
      <div class="bio-column">
        <div class="bio-card paper graph" data-reveal style="--i:2">
          <span class="tape tape--top" style="--tape-rot: -2deg;"></span>
          <p class="blurb bio-lead">{about.lead}</p>
          <div class="bio-body">
            {about.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <!-- Quick Stats -->
          <div class="stats-row">
            {about.stats.map((st) => (
              <div class="stat-item">
                <span class="stat-n display">{st.n}</span>
                <span class="stat-lbl mono">{st.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Skills stickers -->
        <div class="skills-wrapper" data-reveal style="--i:3">
          <h3 class="hand skills-title">my technical toolkit:</h3>
          <div class="stickers-cloud">
            {about.skills.map((skill, idx) => {
              const rot = ((idx % 5) - 2) * 2;
              return (
                <span class="sticker" style={`--rot: ${rot}deg;`}>
                  {skill}
                </span>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Right Column: Polaroid photo stack -->
      <div class="polaroid-column">
        <div class="polaroid-stack">
          {about.polaroids.map((pol, idx) => (
            <figure
              class="polaroid-card"
              style={`--rot: ${pol.tilt}deg; --z: ${3 - idx};`}
              data-reveal
              style={`--i: ${idx + 2}; --rot: ${pol.tilt}deg; --z: ${3 - idx};`}
            >
              <div class="polaroid-photo">
                {pol.image ? (
                  <img src={pol.image} alt={pol.caption} class="polaroid-img" loading="lazy" />
                ) : (
                  <Doodle name={pol.doodle} stroke={2.0} />
                )}
              </div>
              <figcaption class="polaroid-caption hand">
                {pol.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .bio-column {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .bio-card {
    padding: clamp(28px, 4vw, 44px);
    border: 1px solid rgba(20, 24, 31, 0.08);
  }

  .bio-lead {
    color: var(--lime-dark);
    font-size: clamp(22px, 2vw, 26px);
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .bio-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--ink);
    font-size: 17px;
    line-height: 1.65;
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px dashed rgba(20, 24, 31, 0.15);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-n {
    font-size: clamp(28px, 3vw, 40px);
    color: var(--lime-dark);
    line-height: 1;
  }

  .stat-lbl {
    font-size: 11px;
    color: var(--ink-muted);
    margin-top: 4px;
    text-transform: uppercase;
  }

  .skills-wrapper {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .skills-title {
    font-size: 24px;
    color: var(--lime);
  }

  .stickers-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .polaroid-column {
    position: relative;
    display: flex;
    justify-content: center;
    padding-top: 20px;
  }

  .polaroid-stack {
    position: relative;
    width: 100%;
    max-width: 340px;
    height: 480px;
  }

  .polaroid-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    background: #FAFAFA;
    padding: 16px 16px 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    border-radius: 2px;
    transform: rotate(var(--rot, 0deg));
    z-index: var(--z, 1);
    transition: transform var(--dur) var(--ease-spring), z-index 0s;
  }

  .polaroid-card:nth-child(2) { top: 60px; left: 20px; }
  .polaroid-card:nth-child(3) { top: 130px; left: -10px; }

  .polaroid-card:hover {
    transform: rotate(0deg) scale(1.08) translateY(-12px);
    z-index: 10 !important;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .polaroid-photo {
    width: 100%;
    aspect-ratio: 1;
    background: var(--desk-2);
    color: var(--on-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    overflow: hidden;
    border-radius: 2px;
  }

  .polaroid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 2px;
  }

  .polaroid-caption {
    margin-top: 14px;
    text-align: center;
    font-size: 22px;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .polaroid-stack {
      height: 440px;
      margin: 0 auto;
    }
    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

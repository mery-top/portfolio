<style>
  .hero-scene { width: 100%; height: auto; overflow: visible; }
  .hero-scene.is-drawing .draw > * {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw-line 1.4s var(--ease-out) forwards;
    animation-delay: calc(1000ms + var(--k, 0) * 14ms);
  }
  .hero-scene.is-drawing .scene-text {
    opacity: 0;
    animation: fade-in 600ms ease-out 2.2s forwards;
  }
  @keyframes draw-line {
    0% { stroke-dashoffset: 1; fill-opacity: 0; }
    55% { fill-opacity: 0; }
    100% { stroke-dashoffset: 0; fill-opacity: 1; }
  }
  @keyframes fade-in { to { opacity: 1; } }
</style>
